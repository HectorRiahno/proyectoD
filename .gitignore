# =====================================================================
# .gitignore — Proyecto HIS
# Solo se trackea lo necesario para correr el proyecto en local y
# desplegarlo en Vercel/Netlify. Builds, secretos, cachés y configs de
# herramientas locales quedan fuera.
# =====================================================================

# ─── Logs ────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Secretos y variables de entorno ─────────────────────────────────
# Nunca subir .env — usar .env.example como plantilla para nuevos devs
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
# Secretos de Edge Functions (supabase secrets set --env-file ...)
supabase/.env
supabase/.env.*
supabase/functions/.env
supabase/functions/**/.env*

# ─── Datos reales: respaldos y exportaciones ─────────────────────────
# Un volcado de la base o un reporte exportado contiene historias
# clínicas y datos personales: nunca van al repositorio.
*.dump
*.backup
*.bak
*.sql.gz
backup*.sql
respaldo*.sql
dump*.sql
supabase/backups/
supabase/respaldos/
# Cuentas de prueba con contraseñas conocidas: sólo en local
supabase/seed-cuentas-prueba*.sql
exports/
descargas/
*.xlsx
*.xls
*.csv

# ─── Dependencias y artefactos de build ──────────────────────────────
node_modules
dist
dist-ssr
build
out
*.local

# ─── Cachés de bundler / framework ───────────────────────────────────
.vite/
.parcel-cache/
.next/
.cache/
.turbo/
.eslintcache

# ─── Plataformas de despliegue ───────────────────────────────────────
.vercel/
.netlify/

# ─── Tests / coverage ────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── TypeScript ──────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Supabase CLI local (cachés y branches no se versionan) ──────────
supabase/.temp/
supabase/.branches/

# ─── Config de herramientas de IA / asistentes locales ───────────────
.claude/
.cursor/
.aider*
.codeium/

# ─── Notas y borradores internos ─────────────────────────────────────
context.md
NOTES.md
TODO.md
*.draft.md

# ─── IDE / editor ────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Archivos de SO ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
