# Copia este archivo como `.env` y completa los valores.
# Los valores reales están en Vercel → Project → Settings → Environment Variables,
# o en Supabase → Project Settings → API Keys.
#
# ⚠️ Aquí SÓLO va la clave "publishable" (pública). La clave service_role /
#    secret NUNCA va en el frontend ni en este repositorio.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# URL de la Edge Function que invita usuarios (panel admin → Médicos / Usuarios)
VITE_CREATE_DOCTOR_URL=https://TU-PROYECTO.supabase.co/functions/v1/create-user
